FF_PATH  = /data/f-stack-hatcp
PKGCONF ?= pkg-config

CC       = clang
CFLAGS   = -Wall -g -O2 -fno-omit-frame-pointer -fno-optimize-sibling-calls -x c \
           -I$(FF_PATH)/lib \
           -I/usr/local/include \
           -I$(FF_PATH)/tools/libmemstat \
           $(shell $(PKGCONF) --cflags libdpdk) \
           -DHASH_MD5 \
           -DPERF_PROFILING \
           -DSOMIGRATION -DSMCP -DPROTO_BATCHING

DPDK_LIBS = $(shell $(PKGCONF) --static --libs libdpdk)

LDFLAGS  = -g -rdynamic -L/usr/local/lib \
           -lev -lmd \
           -lssl -lcrypto -pthread \
           -L$(FF_PATH)/lib \
           -Wl,--whole-archive $(FF_PATH)/lib/libfstack.a -Wl,--no-whole-archive \
           $(DPDK_LIBS) \
           -lrt -lm -ldl -lnuma

OBJS =          utils.o netutils.o worker.o \
                server.o io.o acc.o stats.o \
                ./plugin/plugin.o \
                ./acc/chunk.o \
                ./acc/compression.o \
                ./acc/dedup.o \
                ./acc/ht.o \
                ./acc/lz4.o \
                ./acc/rbkp.o \
                ./acc/skein/skein.o \
                ./acc/skein/skein_block.o \
                ./proto/http.o \
                app.o main.o

TARGET = wanacc

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(OBJS) -o $@ $(LDFLAGS)

%.o: %.cc
	$(CC) $(CFLAGS) -o $@ -c $<

clean:
	rm -f *.o
	rm -f ./acc/*.o
	rm -f ./acc/skein/*.o
	rm -f ./plugin/*.o
	rm -f ./proto/*.o
	rm -f $(TARGET)
